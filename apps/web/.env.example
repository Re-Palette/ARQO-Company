# Copy to apps/web/.env.local (Next.js) — the worker reads the same variables.
DATABASE_URL=postgres://friday:friday@localhost:5432/friday
CEO_EMAIL=you@example.com
# Auth: "supabase" in production. "local" is for development only (refused when NODE_ENV=production).
AUTH_PROVIDER=local
AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
LOCAL_AUTH_PASSWORD=change-me-12-chars-min
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# APP_URL=https://friday.example.com
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
VAULT_PATH=../../.data/vault
# VAULT_GIT_REMOTE=git@github.com:<owner>/friday-vault.git
# Backup: R2 first, then Supabase Storage, then (development only) a local directory.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=friday-backups
# SUPABASE_BACKUP_BUCKET=backups
# BACKUP_LOCAL_DIR=../../.data/backups
ENABLE_DUMMY_UNIVERSAL_AI=false
UNIVERSAL_AI_WEBHOOK_SECRET=
