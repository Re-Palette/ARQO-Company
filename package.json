{
  "name": "arqo-company",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @friday/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @friday/db generate",
    "db:migrate": "pnpm --filter @friday/db migrate",
    "db:seed": "pnpm --filter @friday/db seed",
    "worker": "pnpm --filter @friday/worker start"
  },
  "devDependencies": {
    "turbo": "^2.11.6",
    "typescript": "^5.9.3"
  }
}
